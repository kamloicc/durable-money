variable "Project.Application.Name" {
    value "durable-money-monolith" {}
}

variable "Project.Application.Port" {
    value "8081" {
        environment = ["development"]
    }

    value "8082" {
        environment = ["staging"]
    }

    value "8083" {
        environment = ["production"]
    }
}

variable "Project.Container.Image" {
    value "ghcr.io/kamloicc/durable-money-1-monolith" {}
}

variable "Project.Database.Host" {
    value "psql-durable-money-l02qe.postgres.database.azure.com" {}
}

variable "Project.Database.JdbcUrl" {
    value "jdbc:postgresql://#{Project.Database.Host}:#{Project.Database.Port}/#{Project.Database.Name}?sslmode=require" {}
}

variable "Project.Database.Name" {
    value "moneydb_dev" {
        environment = ["development"]
    }

    value "moneydb_staging" {
        environment = ["staging"]
    }

    value "moneydb_prod" {
        environment = ["production"]
    }
}

variable "Project.Database.Pool.MaximumSize" {
    value "3" {}
}

variable "Project.Database.Pool.MinimumIdle" {
    value "1" {}
}

variable "Project.Database.Port" {
    value "5432" {}
}

variable "Project.Database.Username" {
    value "dmadmin" {}
}

variable "Project.Kubernetes.ContainerPort" {
    value "8080" {}
}

variable "Project.Kubernetes.DeploymentName" {
    value "durable-money-monolith" {}
}

variable "Project.Kubernetes.ServiceName" {
    value "durable-money-monolith" {}
}

variable "Project.Linux.InstallDirectory" {
    value "/opt/durable-money/dev/monolith" {
        environment = ["development"]
    }

    value "/opt/durable-money/staging/monolith" {
        environment = ["staging"]
    }

    value "/opt/durable-money/prod/monolith" {
        environment = ["production"]
    }
}

variable "Project.Linux.ServiceName" {
    value "durable-money-monolith-dev" {
        environment = ["development"]
    }

    value "durable-money-monolith-staging" {
        environment = ["staging"]
    }

    value "durable-money-monolith-prod" {
        environment = ["production"]
    }
}

variable "Project.Management.Port" {
    value "9081" {
        environment = ["development"]
    }

    value "9082" {
        environment = ["staging"]
    }

    value "9083" {
        environment = ["production"]
    }
}

variable "Project.Windows.InstallDirectory" {
    value "C:\\Apps\\DurableMoney\\Dev\\Monolith" {
        environment = ["development"]
    }

    value "C:\\Apps\\DurableMoney\\Staging\\Monolith" {
        environment = ["staging"]
    }

    value "C:\\Apps\\DurableMoney\\Prod\\Monolith" {
        environment = ["production"]
    }
}

variable "Project.Windows.ServiceName" {
    value "DurableMoney-Monolith-Dev" {
        environment = ["development"]
    }

    value "DurableMoney-Monolith-Staging" {
        environment = ["staging"]
    }

    value "DurableMoney-Monolith-Prod" {
        environment = ["production"]
    }
}

variable "Runbook.Restart.TimeoutSeconds" {
    value "180" {
        process = ["runbook/restart-application"]
    }
}

variable "Runbook.Restart.HealthPath" {
    value "/actuator/health" {
        process = ["runbook/restart-application"]
    }
}

variable "Runbook.Restart.Reason" {
    value {
        process = ["runbook/restart-application"]

        prompt {
            description = "Enter the operational reason or incident reference for this restart."
            display_settings = {
                Octopus.ControlType = "SingleLineText"
            }
            label = "02 - Reason for restart"
            required = true
        }
    }
}

variable "Runbook.Restart.Confirmation" {
    value "CANCEL" {
        process = ["runbook/restart-application"]

        prompt {
            description = "Select RESTART to confirm that the application should be restarted."
            display_settings = {
                Octopus.ControlType = "Select"
                Octopus.SelectOptions = <<-EOT
                    CANCEL|Cancel
                    RESTART|Restart application
                    EOT
            }
            label = "01 - Restart confirmation"
            required = true
        }
    }
}

variable "Project.Windows.ServiceId" {
    value "DurableMoneyMonolithDev" {
        environment = ["development"]
    }

    value "DurableMoneyMonolithStaging" {
        description = ""
        environment = ["staging"]
    }

    value "DurableMoneyMonolithProd" {
        description = ""
        environment = ["production"]
    }
}

variable "Database Connectivity Check" {
    value "10" {
        process = ["runbook/database-connectivity-check"]
    }
}

variable "Runbook.Database.TimeoutSeconds" {
    value "10" {
        process = ["runbook/database-connectivity-check"]
    }
}