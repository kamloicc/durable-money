step "approve-production-deployment" {
    name = "Approve Production deployment"

    action {
        action_type = "Octopus.Manual"
        environments = ["production"]
        notes = <<-EOT
                Production deployment requires an audited manual approval.
                This description is managed through Octopus Config as Code.
                EOT
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = <<-EOT
                Review the Durable Money Production deployment before proceeding.
                
                Project: #{Octopus.Project.Name}
                Release: #{Octopus.Release.Number}
                Environment: #{Octopus.Environment.Name}
                
                Review the release notes and confirm:
                
                1. Development deployment succeeded.
                2. Staging deployment succeeded.
                3. Linux Staging responds on port 8082.
                4. Windows Staging responds on port 8082.
                5. AKS Staging rollout is healthy.
                6. The release contains the expected package and image versions.
                7. There are no unresolved deployment incidents.
                
                Release notes:
                
                #{Octopus.Release.Notes}
                
                Enter an approval or rejection reason in the Notes field.
                EOT
            Octopus.Action.Manual.ResponsibleTeamIds = "durable-money-release-managers"
            Octopus.Action.RunOnServer = "false"
        }
    }
}

step "deploy-monolith-to-linux" {
    name = "Deploy monolith to Linux"
    properties = {
        Octopus.Action.TargetRoles = "durable-money-linux"
    }

    action {
        action_type = "Octopus.TentaclePackage"
        properties = {
            Octopus.Action.EnabledFeatures = "Octopus.Features.ConfigurationVariables,Octopus.Features.ConfigurationTransforms"
            Octopus.Action.Package.AutomaticallyRunConfigurationTransformationFiles = "True"
            Octopus.Action.Package.AutomaticallyUpdateAppSettingsAndConnectionStrings = "True"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "durable-money-monolith-linux"
            Octopus.Action.RunOnServer = "false"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "durable-money-monolith-linux"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "deploy-monolith-to-windows" {
    name = "Deploy monolith to Windows"
    properties = {
        Octopus.Action.TargetRoles = "durable-money-windows"
    }

    action {
        action_type = "Octopus.TentaclePackage"
        properties = {
            Octopus.Action.EnabledFeatures = "Octopus.Features.ConfigurationVariables,Octopus.Features.ConfigurationTransforms"
            Octopus.Action.Package.AutomaticallyRunConfigurationTransformationFiles = "True"
            Octopus.Action.Package.AutomaticallyUpdateAppSettingsAndConnectionStrings = "True"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "durable-money-monolith-windows"
            Octopus.Action.RunOnServer = "false"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "durable-money-monolith-windows"
            properties = {
                SelectionMode = "immediate"
            }
        }
    }
}

step "deploy-monolith-to-aks" {
    name = "Deploy monolith to AKS"
    properties = {
        Octopus.Action.TargetRoles = "durable-money-kubernetes"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.GitRepository.Source = "External"
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: v1
                kind: Secret
                metadata:
                  name: durable-money-monolith-db
                  namespace: #{Library.DurableMoney.Kubernetes.Namespace}
                  labels:
                    app.kubernetes.io/name: durable-money-monolith
                    app.kubernetes.io/managed-by: octopus-deploy
                type: Opaque
                stringData:
                  username: "#{Project.Database.Username}"
                  password: "#{Project.Database.Password}"
                ---
                apiVersion: apps/v1
                kind: Deployment
                metadata:
                  name: #{Project.Kubernetes.DeploymentName}
                  namespace: #{Library.DurableMoney.Kubernetes.Namespace}
                  labels:
                    app.kubernetes.io/name: durable-money-monolith
                    app.kubernetes.io/managed-by: octopus-deploy
                spec:
                  replicas: 1
                  strategy:
                    type: RollingUpdate
                  selector:
                    matchLabels:
                      app.kubernetes.io/name: durable-money-monolith
                  template:
                    metadata:
                      labels:
                        app.kubernetes.io/name: durable-money-monolith
                        app.kubernetes.io/managed-by: octopus-deploy
                    spec:
                      terminationGracePeriodSeconds: 30
                      containers:
                        - name: monolith
                          image: "#{Octopus.Action.Package[monolith-image].Image}"
                          imagePullPolicy: IfNotPresent
                          ports:
                            - name: http
                              containerPort: #{Project.Kubernetes.ContainerPort}
                              protocol: TCP
                          env:
                            - name: PORT
                              value: "#{Project.Kubernetes.ContainerPort}"
                            - name: MANAGEMENT_PORT
                              value: "8081"
                            - name: SPRING_DATASOURCE_URL
                              value: "#{Project.Database.JdbcUrl}"
                            - name: DB_USER
                              valueFrom:
                                secretKeyRef:
                                  name: durable-money-monolith-db
                                  key: username
                            - name: DB_PASS
                              valueFrom:
                                secretKeyRef:
                                  name: durable-money-monolith-db
                                  key: password
                            - name: SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE
                              value: "#{Project.Database.Pool.MaximumSize}"
                            - name: SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE
                              value: "#{Project.Database.Pool.MinimumIdle}"
                          resources:
                            requests:
                              cpu: 100m
                              memory: 256Mi
                            limits:
                              cpu: 500m
                              memory: 768Mi
                          startupProbe:
                            tcpSocket:
                              port: http
                            periodSeconds: 5
                            failureThreshold: 30
                          readinessProbe:
                            tcpSocket:
                              port: http
                            periodSeconds: 10
                            failureThreshold: 6
                          livenessProbe:
                            tcpSocket:
                              port: http
                            periodSeconds: 20
                            failureThreshold: 3
                ---
                apiVersion: v1
                kind: Service
                metadata:
                  name: #{Project.Kubernetes.ServiceName}
                  namespace: #{Library.DurableMoney.Kubernetes.Namespace}
                  labels:
                    app.kubernetes.io/name: durable-money-monolith
                    app.kubernetes.io/managed-by: octopus-deploy
                spec:
                  type: ClusterIP
                  selector:
                    app.kubernetes.io/name: durable-money-monolith
                  ports:
                    - name: http
                      port: 80
                      targetPort: http
                      protocol: TCP
                EOT
            Octopus.Action.KubernetesContainers.CustomResourceYamlFileName = "octopus/kubernetes/monolith.yaml"
            Octopus.Action.Script.ScriptSource = "GitRepository"
        }
        worker_pool = "hosted-windows"
        worker_pool_variable = ""

        git_dependencies {
            default_branch = "main"
            file_path_filters = ["octopus/kubernetes/monolith.yaml"]
            git_credential_type = "Anonymous"
            repository_uri = "https://github.com/kamloicc/durable-money.git"
        }

        packages "monolith-image" {
            acquisition_location = "NotAcquired"
            feed = "github-container-registry"
            package_id = "kamloicc/durable-money-1-monolith"
            properties = {
                Extract = "False"
                Purpose = "DockerImageReference"
                SelectionMode = "immediate"
            }
        }
    }
}